      "includes": [
        "#include <stdio.h>"
      ],
      "clauses": [
        {
          "clause_id": "read_n",
          "signature": "int read_n(void)",
          "code": "int n; scanf(\"%d\", &n); return n;\n"
        },
        {
          "clause_id": "is_strict",
          "signature": "int is_strict(int n)",
          "code": "int prev; scanf(\"%d\", &prev);\nfor(int i=1;i<n;i++){\n  int x; scanf(\"%d\", &x);\n  if(!(prev<x)) return 0;\n  prev=x;\n}\nreturn 1;\n"
        },
        {
          "clause_id": "main",
          "signature": "int main(void)",
          "code": "int main(void){ int n=read_n(); puts(is_strict(n)?\"Yes\":\"No\"); return 0; }\n"
        }
      ]
