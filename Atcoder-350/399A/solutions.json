      "includes": [
        "#include <stdio.h>",
        "#include <string.h>"
      ],
      "clauses": [
        {
          "clause_id": "read_strings",
          "signature": "void read_strings(char *s, char *t)",
          "code": "scanf(\"%1000s %1000s\", s, t);\n"
        },
        {
          "clause_id": "can_match",
          "signature": "int can_match(const char *s, const char *t)",
          "code": "int n=(int)strlen(s);\nif((int)strlen(t)!=n) return 0;\nfor(int i=0;i<n;i++) if(s[i]!=t[i]) return 0;\nreturn 1;\n"
        },
        {
          "clause_id": "main",
          "signature": "int main(void)",
          "code": "int main(void){ char s[1100],t[1100]; read_strings(s,t); puts(can_match(s,t)?\"Yes\":\"No\"); return 0; }\n"
        }
      ]
